{
    // Volet navigateur de Claude Code. Il n'accepte que http://localhost:<port>.
    //
    // La preview lance sa PROPRE pile complete (Vite + Fastify) sur des ports decales de +1000,
    // afin que `npm run dev` dans l'IDE (web 5173, serveur 8787) continue de tourner en parallele :
    //   PORT           -> port de Vite            (apps/web/vite.config.ts)
    //   KASBAH_PORT    -> port de Fastify         (apps/server/src/config/env.ts)
    //   KASBAH_SERVER  -> cible du proxy /api,/ws (apps/web/vite.config.ts) = le serveur de la preview
    // Ces variables gagnent sur apps/server/.env : ni dotenv ni `node --env-file` n'ecrasent
    // process.env. Garder "port" en phase avec PORT.
    //
    // ATTENTION : seuls les PORTS sont dedoubles. Les deux serveurs partagent le fichier de maison
    // (house/demo-house.json, qui porte AUSSI les plugins actifs et leurs sous-items) et la memoire
    // des appareils Cast deja vus (apps/server/.state/google-cast-devices.json, CAST_KNOWN_FILE),
    // tous ecrits en `.tmp` + rename : deux ecritures simultanees se marchent dessus (la memoire Cast
    // nomme son `.tmp` d'apres le pid, justement pour l'eviter). Ils pilotent aussi le MEME materiel
    // reel. S'en tenir a la lecture cote preview (cocher un plugin dans Reglages ECRIT la maison des
    // deux serveurs), ou VITE_INPROCESS_MOCK=1 qui n'a besoin d'aucun serveur.
    "version": "0.0.1",
    "configurations": [
        {
            "name": "kasbah",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "env": {
                "PORT": "6173",
                "KASBAH_PORT": "9787",
                "KASBAH_SERVER": "http://localhost:9787"
            },
            "port": 6173,
            // `true` : une seconde session prend le port libre suivant au lieu d'echouer
            // quand une autre tient deja 6173 (le proxy /api suit KASBAH_SERVER, inchange).
            "autoPort": true
        },
        {
            // Le front SEUL, branche sur un serveur deja demarre (8787 par defaut, ou KASBAH_SERVER).
            // Utile quand une autre session tient deja le serveur Fastify.
            "name": "kasbah-web",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev", "-w", "@kasbah/web"],
            "port": 5174,
            "autoPort": true
        }
    ]
}
