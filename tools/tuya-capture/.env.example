# Identifiants de l'appareil, obtenus une fois via la plateforme développeur Tuya (voir capture.mjs).
TUYA_ID=
TUYA_KEY=
# Optionnels. Sans IP, le script cherche l'appareil par diffusion UDP sur le LAN (ports 6666/6667)
# et en déduit la version du protocole. Un appareil en 3.5 ne répond pas à cette recherche :
# donner alors l'IP et TUYA_VERSION=3.5.
# TUYA_IP=192.168.1.42
# TUYA_VERSION=3.3
