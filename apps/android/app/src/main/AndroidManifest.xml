<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Parler": the car's microphone reaches the app through this permission. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Read by the "Voiture" probe screen, granted by the driver on first use. -->
    <uses-permission android:name="com.google.android.gms.permission.CAR_FUEL" />
    <uses-permission android:name="com.google.android.gms.permission.CAR_SPEED" />
    <uses-permission android:name="com.google.android.gms.permission.CAR_MILEAGE" />
    <!-- The car's own GPS position, shown by the probe screen. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- The approach alert: a geofence around the house wakes the app while it is closed. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A reboot erases the geofences: placed again at start-up. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      The preferences hold the session cookie and the house position: kept out of the Google backup and of
      a transfer to a new phone (data_extraction_rules.xml from Android 12, backup_rules.xml before).
    -->
    <application
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Kasbah Auto"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Kasbah">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />
        <meta-data
            android:name="androidx.car.app.theme"
            android:resource="@style/CarAppTheme" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          On the phone, "Kasbah Auto" with a car badge: the installed web app is "Kasbah" with the same
          logo. In the car there is no web app to tell apart: plain name and logo.
        -->
        <service
            android:name=".KasbahCarAppService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_car"
            android:label="Kasbah">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".ApproachReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
