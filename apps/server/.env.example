# ---- Serveur -------------------------------------------------------------
KASBAH_PORT=8787
KASBAH_HOST=0.0.0.0
# Quels plugins sont ACTIFS ne se décide plus ici : c'est un choix de la maison, coché dans
# Réglages → Plugins et écrit dans house.json (`plugins`). Ce fichier ne porte que les clés et les
# secrets. Une maison sans section `plugins` démarre avec la simulation seule.
# Fichier de description de la maison (défaut : house/demo-house.json à la racine du dépôt).
# KASBAH_HOUSE_FILE=../../house/ma-maison.json
# Dossier du build web servi en production (défaut : apps/web/dist).
# KASBAH_STATIC_DIR=../web/dist
KASBAH_LOG_LEVEL=info
KASBAH_LOG_PRETTY=true
# true → une config de plugin invalide empêche le démarrage (au lieu de désactiver le plugin).
KASBAH_STRICT_PLUGINS=false
KASBAH_COMMAND_TIMEOUT_MS=10000

# ---- Plugin mock (simulation) --------------------------------------------
# Ce que la simulation fournit se decoche dans Reglages -> Plugins (un sous-item par type
# d'appareil), pas ici. Sert a la faire COMPLETER un parc reel au lieu de le doubler : des qu'un
# vrai plugin couvre un kind, ses equivalents simules n'ont plus a encombrer les listes en « hors
# plan ». Decocher emporte ce qui appartient a l'INSTALLATION du kind : sortir `energy` retire le
# site solaire simule ET ses vingt panneaux, qui sont des capteurs de puissance mais font partie de
# la meme installation. Les autres capteurs simules (piscine, filtration) restent en place.
# default | empty | chaos | winter
MOCK_SCENARIO=default
MOCK_SEED=42
# Accélération du temps simulé (60 → une journée en 24 minutes).
MOCK_TIME_SCALE=1
# Date de départ simulée (ISO 8601). Défaut : maintenant.
# MOCK_START_TIME=2026-06-21T06:00:00+02:00

# ---- Plugin Philips Hue ---------------------------------------------------
# IP du bridge (recommandé : fixer un bail DHCP). Absent → découverte via discovery.meethue.com.
HUE_BRIDGE_HOST=192.168.1.20
# Clé d'application obtenue par appairage : lancez le serveur sans clé, appuyez sur le bouton du
# bridge puis POST http://localhost:8787/api/plugins/hue/pair (ou bouton « Appairer » dans Réglages).
# HUE_APP_KEY=
# Exposer aussi les pièces Hue (grouped_light) comme appareils.
HUE_EXPOSE_ROOMS=false
# Le bridge présente un certificat signé par l'autorité Signify (pas par une AC publique).
HUE_TLS_INSECURE=true

# ---- Plugin Somfy TaHoma (volets, stores, portails) -----------------------
# API LOCALE du mode developpeur : aucun appel cloud, ni a la mise en route ni au fonctionnement.
# Tout se fait dans l'appli mobile « TaHoma by Somfy », il n'y a pas de parcours web equivalent :
#   1. « Configurer l'installation » > « Acceder aux parametres » de la box, puis activer le mode
#      developpeur en tapant SEPT FOIS sur le code PIN de la passerelle (format 2001-0001-1891).
#   2. Resynchroniser la box (l'API locale n'est vraiment servie qu'apres).
#   3. Menu « Mode developpeur » > generer un jeton, et le copier TOUT DE SUITE : il n'est
#      affichable qu'a la creation.
#   4. Coller ce jeton dans TAHOMA_TOKEN ci-dessous.
# Adresse de la box : son certificat est emis pour gateway-<PIN>.local, ce nom marche si le mDNS
# passe. Sinon mettre l'IP (bail DHCP fixe recommande) et garder TAHOMA_TLS_INSECURE=true.
TAHOMA_HOST=gateway-2001-0001-1891.local
TAHOMA_PORT=8443
# TAHOMA_TOKEN=
# Le certificat de la box est signe par l'AC Overkiz (pas par une AC publique).
TAHOMA_TLS_INSECURE=true
# L'API locale ne pousse rien : on sonde un ecouteur d'evenements a cette cadence.
TAHOMA_POLL_MS=2000

# ---- Plugin Google Nest (cameras, sonnettes, ecrans a camera) ----------------
# API CLOUD « Smart Device Management » : les appareils Nest n'ont pas d'API locale, rien n'est
# decouvert sur le LAN. Mise en route cote Google, une seule fois (environ 15 minutes, 5 USD) :
#   1. https://console.cloud.google.com : creer un projet, activer l'API « Smart Device Management »,
#      puis « Identifiants » > creer un « ID client OAuth » de type APPLICATION WEB, avec pour URI
#      de redirection autorise EXACTEMENT la valeur de NEST_REDIRECT_URI ci-dessous. Puis passer
#      l'ecran de consentement en « In production » : en mode « Testing », Google fait expirer le
#      jeton au bout de 7 jours (cause probable du « Token has been expired or revoked » constate le
#      2026-10-01, compte a relier de nouveau).
#      Pour un usage personnel, Google affiche seulement un avertissement « application non verifiee ».
#   2. https://console.nest.google.com/device-access : accepter les conditions (5 USD une fois),
#      creer un projet en y collant l'ID client OAuth de l'etape 1. L'id du projet (UUID) est
#      NEST_PROJECT_ID. Les evenements Pub/Sub (sonnette) sont pris en charge : voir NEST_PUBSUB_* plus bas.
#   3. Lancer le serveur : le plugin est en « needs_pairing » ; le bouton « Lier le compte Google »
#      des Reglages (ou GET http://localhost:8787/api/plugins/nest/auth/url) ouvre le consentement
#      Google, ou l'on choisit les cameras a partager. Au retour, la page affiche le jeton a coller
#      dans NEST_REFRESH_TOKEN. Le serveur n'ecrit jamais ce fichier.
# Les cameras Nest ne se lient qu'a un compte GOOGLE : un ancien compte Nest doit d'abord etre migre.
# NEST_PROJECT_ID=
# NEST_CLIENT_ID=
# NEST_CLIENT_SECRET=
# NEST_REFRESH_TOKEN=
# Doit correspondre a l'URI declaree dans le client OAuth (le port est celui de KASBAH_PORT).
NEST_REDIRECT_URI=http://localhost:8787/api/plugins/nest/auth/callback
# L'API ne pousse rien (tant que Pub/Sub n'est pas branche) : la liste des appareils est relue a cette
# cadence pour l'etat du thermostat et les ajouts / retraits. Google borne les appels a quelques-uns
# par minute : ne pas descendre trop bas.
NEST_POLL_MS=60000
# Vidéo des caméras RTSP (tout le parc Nest de 1re génération) : un processus ffmpeg par caméra
# regardée recopie le flux (sans ré-encodage) vers le navigateur. Binaire à trouver dans le PATH,
# ou chemin complet ici.
FFMPEG_PATH=ffmpeg
# Vue Cameras : sessions RTSP ouvertes en meme temps, au plus (directs regardes + vignettes). C'est ce
# qui coute (une session Google, un ffmpeg et 1 a 2 Mbit/s par camera), pas la cadence des images.
# En dessous du nombre de cameras, les vignettes tournent en rotation (~20 s de presence chacune).
NEST_LIVE_BUDGET=10
# Cadence des vignettes JPEG (une par camera dont la session est ouverte).
NEST_SNAPSHOT_MS=10000
# Evenements Pub/Sub (sonnette, mouvement). Optionnel : sans abonnement, aucun evenement, le reste
# marche. Cote Google : projet Cloud avec facturation active (Pub/Sub l'exige, mais le volume d'un
# foyer reste dans le quota gratuit ~ 0 EUR), API Pub/Sub activee, un sujet, un abonnement de type
# PULL, droit de publication donne au compte Device Access, sujet valide dans la console Device
# Access, et la liaison OAuth refaite (portee pubsub). Voir doc/3_plugins/3_5_google-nest.md.
# Nom COMPLET de l'abonnement (projet Cloud, pas l'UUID Device Access) :
# NEST_PUBSUB_SUBSCRIPTION=projects/<projet-cloud>/subscriptions/nest-events-sub
# Cadence de tirage de l'abonnement (une sonnerie arrive au plus tard au prochain tirage).
NEST_PUBSUB_POLL_MS=5000

# ---- Plugin Google Cast (enceintes et reveils Google / Nest, Chromecast, TV Android) ---------
# Tout est LOCAL : decouverte mDNS (_googlecast._tcp), une connexion TLS par appareil, aucun compte.
# Le nom, le modele et l'identifiant stable viennent de l'annonce mDNS ; volume, appli en cours et
# lecture sont pousses par l'appareil. Penser a decocher « Lecteur » dans les sous-items du mock.
# Machine a plusieurs cartes reseau (VPN, machines virtuelles) : la question mDNS peut partir sur la
# mauvaise. Donner ici l'IPv4 de la carte qui est sur le LAN des appareils.
# CAST_MDNS_INTERFACE=192.168.1.10
# Temps laisse aux appareils pour repondre a la premiere question avant de rendre la liste.
CAST_DISCOVERY_WAIT_MS=3000
# Cadence des questions mDNS suivantes (appareils rallumes, annonces perdues).
CAST_MDNS_REFRESH_MS=60000
# Memoire des appareils deja vus : un Cast ETEINT ne s'annonce plus en mDNS. Sans elle il quitte
# l'inventaire, et une entree de house.json qui le vise perd son nom, son icone et son etat. Retenu ici,
# il reste liste (indisponible) et se rattache des qu'il se reannonce ; le bouton « Oublier l'appareil »
# de l'UI l'en sort. Chaine vide = ne rien retenir.
# CAST_KNOWN_FILE=apps/server/.state/google-cast-devices.json
# Lectures Crunchyroll : l'appli n'envoie que le titre de l'episode ; le serveur complete serie, saison,
# numero et vignette par l'API interne du service, en ANONYME (aucun compte). Non officiel, peut casser
# sans preavis ; en cas d'echec l'affichage reste celui de l'appareil. false pour s'en passer.
CAST_CRUNCHYROLL_ENRICH=true
# Pochette d'un morceau que l'appareil NOMME sans l'illustrer (une appli de TV Android n'envoie aucune
# image, et son identifiant de contenu est vide) : cherchee par titre + artiste dans les catalogues
# publics iTunes puis Deezer, sans cle ni compte. La correspondance est VERIFIEE avant d'accepter une
# image (iTunes repond toujours quelque chose, meme sans rapport) ; sinon il reste le logo de l'appli.
# C'est la pochette de l'ALBUM, pas la vignette de la video. false pour s'en passer.
CAST_COVER_LOOKUP=true
# TV Sony (modele BRAVIA) : lui demander OU PART SON SON par son API REST locale (port 80, sans cle ni
# appairage) toutes les 10 s tant qu'elle est connectee. Une TV en HDMI ARC fait jouer une barre de son
# que le protocole Cast voit au repos ; publie dans l'etat `audioOutput` (haut-parleurs / systeme audio,
# nom CEC de l'appareil branche). L'UI y pose l'onde sonore avec le lien `meta.audioOutput` de house.json
# (sur l'appareil TV : l'id maison de la barre). false pour s'en passer.
CAST_BRAVIA_PROBE=true

# ---- Plugin Sonos (enceintes, Port) ----------------------------------------------------------
# Tout est LOCAL : decouverte SSDP (ZonePlayer, UDP 1900), SOAP UPnP sur le port 1400, aucun compte
# ni secret. Le WebSocket :1443 exige une cle d'API cloud : hors phase 1. Penser a decocher
# « Lecteur » dans les sous-items du mock. Machine a plusieurs cartes (VPN, APIPA 169.254) : lier
# le multicast a l'IPv4 du LAN, sinon la question SSDP reste muette.
# SONOS_SSDP_INTERFACE=192.168.1.10
# Cadence des questions SSDP suivantes (appareils rallumes).
SONOS_SSDP_REFRESH_MS=60000
# Relecture volume / lecture. 2 s : assez vif pour le curseur, sans inonder l'enceinte.
SONOS_POLL_MS=2000
# Borne d'une requete SOAP (le defaut undici est 300 s).
SONOS_REQUEST_TIMEOUT_MS=5000
# Memoire des enceintes deja vues : une Sonos eteint ne repond plus au SSDP. Chaine vide = ne rien
# retenir. Le bouton « Oublier l'appareil » de l'UI l'en sort.
# SONOS_KNOWN_FILE=apps/server/.state/sonos-devices.json

# --- Enphase (production solaire, micro-onduleurs, batteries) ------------------------------------
# Passerelle IQ lue en LOCAL : aucun quota cloud, aucune dependance a Internet une fois le jeton pose.
# Nom ou IP de la passerelle. `envoy.local` est le nom qu'elle porte sur le LAN (HTTPS seul : son
# port 80 refuse la connexion, et son certificat est auto-signe, ce que le serveur accepte pour elle).
ENPHASE_HOST=envoy.local
# Le logiciel 7.0 et plus exige un JETON (JWT). RIEN A METTRE ICI dans le cas normal : l'appairage se
# fait depuis la carte « Passerelle Enphase » des Reglages, et le serveur garde le jeton lui-meme
# dans ENPHASE_TOKEN_FILE (voir plus bas). Il n'y a donc rien a recopier, meme en appairant depuis
# un autre poste que le serveur, et le jeton vaut un an. Le serveur previent quand il reste moins de 30 jours
# (pastille orange des Reglages), et a l'heure pres le dernier jour.
# La carte propose deux voies. Les identifiants du compte Enphase, qui traversent la requete, servent
# une fois a frapper le jeton et sont OUBLIES : ni journalises, ni ecrits, ni des cles de ce fichier.
# Ou un jeton deja cree sur https://entrez.enphaseenergy.com, a coller dans la carte.
# ATTENTION au formulaire web du fabricant : pour un compte a la fois installateur et proprietaire
# (un auto-installateur), il ne delivre qu'un jeton de 12 H. Seule la voie par identifiants rend
# celui d'un an. Le role est lisible dans le jeton, et les Reglages l'affichent.
# Le numero de serie n'est jamais a saisir : /info le donne sans authentification.
# La cle ci-dessous reste lue, comme jeton d'AMORCAGE : utile pour un premier demarrage sans
# interface, ou pour forcer un jeton precis. Entre ce jeton et celui du cache, le serveur garde
# celui qui expire LE PLUS TARD, donc un vieux jeton oublie ici n'eclipse pas un jeton frais.
# ENPHASE_TOKEN=
# Ou garder le jeton entre deux demarrages (il vaut un an) : c'est ce qui evite de retaper quoi que
# ce soit. Chaine vide = ne rien garder, et donc reappairer a chaque demarrage.
# ENPHASE_TOKEN_FILE=apps/server/.state/enphase-token.json
# Session Enlighten (borne IQ EV Charger 2). Distincte du jeton local : coller un JWT de passerelle
# n'ouvre PAS le cloud. Ouverte en appairant avec le compte, jamais avec un jeton colle. Chaine
# vide = ne pas garder la session.
# ENPHASE_CLOUD_FILE=apps/server/.state/enphase-cloud.json

# --- Tesla (vehicules) ---------------------------------------------------------------------------
# Fleet API, CLOUD du fabricant : il n'existe rien en local. Lecture (charge, autonomie, cable,
# verrouillage, position, kilometrage, vitesse, pneus, temperatures, veille, mise a jour en attente)
# et commandes : reveil, limite de charge, lancer / arreter la charge, climatisation (consigne,
# sieges et volant chauffants), programmer / annuler une mise a jour logicielle. Verrouiller n'est
# pas encore fait. Mise en route en trois pas, guides par la carte « Tesla » des Reglages :
#   1. https://developer.tesla.com : creer une application (type « Authorization Code »). Origine
#      autorisee = votre domaine public en HTTPS (celui de TESLA_DOMAIN), redirection = la valeur de
#      TESLA_REDIRECT_URI ci-dessous, toutes les portees vehicule cochees. Copier ici l'ID client et
#      le secret. Aucune carte bancaire n'est necessaire : Tesla offre 10 $ par mois, et coupe
#      au-dela — le budget ci-dessous est la pour ne jamais l'atteindre.
#   2. Poser la CLE PUBLIQUE de l'application (affichee dans la carte, ou GET
#      http://localhost:8787/api/plugins/tesla/public-key) sur votre domaine, a l'adresse exacte
#      https://<TESLA_DOMAIN>/.well-known/appspecific/com.tesla.3p.public-key.pem (fichier texte,
#      HTTPS). C'est la preuve que le domaine est a vous ; la cle privee reste dans TESLA_KEY_FILE.
#      Puis « Enregistrer le domaine » dans la carte : le serveur le declare a Tesla et verifie ce
#      que Tesla a lu. UN DOMAINE N'APPARTIENT QU'A UNE APPLICATION : recreer l'application (autre
#      compte developpeur) rend le domaine « deja pris » — garder la premiere application, n'importe
#      quel compte Tesla peut ensuite lui donner acces a sa voiture. Reenregistrer met a jour la cle.
#   3. « Lier le compte Tesla » : consentement dans un onglet, puis les jetons sont gardes par le
#      serveur dans TESLA_TOKEN_FILE. Rien a recopier ; le refresh token est a usage unique et
#      reecrit a chaque rafraichissement, c'est pourquoi ce fichier compte.
# TESLA_CLIENT_ID=
# TESLA_CLIENT_SECRET=
# Domaine (hote seul, sans https://) qui sert la cle publique.
# TESLA_DOMAIN=nas-exemple.synology.me
# Region du compte Tesla : eu ou na. Decide la base de l'API.
TESLA_REGION=eu
# Doit correspondre a l'URI declaree dans l'application (le port est celui de KASBAH_PORT).
TESLA_REDIRECT_URI=http://localhost:8787/api/plugins/tesla/auth/callback
# TESLA_TOKEN_FILE=apps/server/.state/tesla-token.json
# TESLA_KEY_FILE=apps/server/.state/tesla-key.json
# Ce qui survit a un redemarrage, et qui n'est ni un secret ni un jeton : le DERNIER ETAT de chaque
# vehicule (sans lui, la carte repart vide jusqu'a la prochaine lecture, qui peut attendre des heures
# que la voiture se reveille) et la CONSOMMATION du mois en cours (la jauge de la vue Vehicules).
# Chaine vide = ne rien garder.
# TESLA_STATE_FILE=apps/server/.state/tesla-state.json
# La voiture DORT un quart d'heure apres s'etre garee, et repond 408 a toute lecture jusqu'a son
# reveil. Le plugin lit la LISTE des vehicules a cette cadence (elle donne la veille sans reveiller),
# et ne fait la lecture complete — la seule qui coute vraiment, 1 $ pour 500 — que si le vehicule
# est eveille. Il ne le reveille JAMAIS pour lire : seuls le bouton « Reveiller » et les gestes qui
# l'exigent (climatiser, lancer la charge, depuis l'UI ou une automatisation) reveillent la voiture,
# a 1 $ pour 50 chez Tesla. Un simple reglage (limite de charge...) est refuse tant qu'elle dort.
TESLA_POLL_MS=600000
# Vu au repos (gare, personne a bord, pas en charge), le vehicule n'est pas relu avant ce delai : le
# temps qu'il s'endorme. Un Model S ou X d'avant 2021 peut etre maintenu eveille par les lectures ;
# les autres non, mais relire une voiture qui ne fait rien n'apprend rien. 0 = pas de repos.
TESLA_REST_MS=900000
# Lectures completes par jour, au plus. 100 = 6 $ par mois dans le pire cas, sous le credit. Au-dela,
# seule la veille est suivie jusqu'au lendemain. 0 = veille seule.
TESLA_DAILY_DATA_BUDGET=100

# --- Renault (vehicules) -------------------------------------------------------------------------
# API PRIVEE du fabricant (Gigya + Kamereon), celle de l'appli MY Renault : il n'existe aucune voie
# officielle pour un particulier. Le portail developpeur d'Ampere ne sert qu'aux applis Android qui
# tournent DANS la voiture, et les donnees vehicule sont revendues en B2B par un agregateur.
# Lecture, et commandes : limite de charge, lancer / arreter la charge, climatisation. Les commandes
# sont DEPOSEES chez Renault et n'atteignent la voiture qu'a la prochaine connexion de son boitier.
#
# Mise en route : rien a mettre ici. Le compte se relie depuis les Reglages (identifiant et mot de
# passe MY Renault). LE MOT DE PASSE N'EST NI GARDE NI ECRIT : il est echange une fois contre un
# jeton de session Gigya, seul ce jeton va dans RENAULT_SESSION_FILE. Un compte avec double
# authentification ne peut pas etre relie (Gigya la refuse a un tiers).
#
# Les quatre valeurs ci-dessous sont les points d'entree et cles de fr_FR. Elles ont un defaut dans
# le code et ne sont a renseigner QUE si Renault les change — ce qui arrive : la rotation de mai
# 2026 a mis en panne toutes les integrations tierces le meme jour.
# RENAULT_GIGYA_URL=https://accounts.eu1.gigya.com
# RENAULT_GIGYA_API_KEY=
# RENAULT_KAMEREON_URL=https://api-wired-prod-1-euw1.wrd-aws.com
# RENAULT_KAMEREON_API_KEY=
# Pays du compte, exige en parametre sur toutes les routes Kamereon.
RENAULT_COUNTRY=FR
# Compte Kamereon a lire, si la personne en a plusieurs (MYRENAULT, MYDACIA...). Vide = le compte
# MYRENAULT, a defaut le premier.
# RENAULT_ACCOUNT_ID=
# Jeton de session Gigya. Le mot de passe du compte n'y figure jamais.
# RENAULT_SESSION_FILE=apps/server/.state/renault-session.json
# Cadence de lecture, 10 min comme Tesla. Cinq lectures par vehicule et par tour, soit une trentaine
# d'appels par heure — sous les 60 que Renault tolere.
# RENAULT_POLL_MS=600000
# Plafond que le plugin s'impose, pour refuser lui-meme avant que Renault ne reponde 429.
# RENAULT_RATE_PER_HOUR=60
# Reveil de charge (sous-item « Reveil de charge », coche par defaut dans les Reglages). La R5 ne
# reprend PAS la charge d'elle-meme apres une coupure de courant a la borne (charge sur surplus
# solaire : un nuage suffit). Ce que le plugin fait alors : reecrire ses reglages VE a l'identique,
# horodatage neuf, et les reglages que vous avez choisis (heure de depart, duree, temperature)
# restent intacts. Ce n'est pas une ecriture immediate mais une COMMANDE deposee chez Renault, que
# la voiture n'applique qu'a sa prochaine connexion : une voiture deja endormie ne se reveille PAS
# par l'API (constate le 2026-09-19, l'appli MY Renault n'y arrivait pas davantage). Renault impose
# aussi un delai entre deux commandes (refus 409, traite comme un report, pas comme une erreur).
# Fenetre horaire, en heure LOCALE du serveur : la nuit, une voiture branchee qui ne charge pas
# attend le plus souvent sa charge programmee, et la secouer serait se battre contre ce reglage.
# Bornes egales = jamais (l'autre facon de couper la fonction).
# RENAULT_WAKE_FROM=08:00
# RENAULT_WAKE_TO=20:00
# Delai minimal entre deux reveils du meme vehicule.
# RENAULT_WAKE_EVERY_MS=900000
# ---- Plugin Open-Meteo (meteo au-dessus de la maison) -------------------------------------
# API LIBRE, sans cle ni compte (usage non commercial, donnees CC BY 4.0 : l'attribution est affichee
# par l'app). La position vient de `origin` dans house.json : rien a saisir ici. Deux appels par
# sondage (previsions, puis qualite de l'air et pollens du programme europeen CAMS), soit ~300 appels
# par jour sur les 10 000 toleres. Les modeles se relancent a l'heure : sonder plus souvent que
# toutes les dix minutes relit la meme chose.
# OPEN_METEO_POLL_MS=600000

# ---- Plugin Husqvarna Automower (robot tondeuse) ---------------------------------------------
# Automower Connect API, CLOUD du fabricant : il n'existe rien en local. Mise en route, une fois :
#   1. https://developer.husqvarnagroup.cloud : se connecter avec le compte de l'appli Automower
#      Connect (celui qui possede le robot), creer une application, et la relier aux DEUX API
#      « Authentication API » et « Automower Connect API ». Peu importe l'URL de redirection : elle
#      ne sert pas ici.
#   2. Copier la cle (« Application key ») et le secret ci-dessous. Rien d'autre : le jeton se
#      redemande tout seul (client_credentials), il vaut une journee, et il n'y a pas de page de
#      consentement — l'application EST le compte.
# Quota du fabricant (portail developpeur, releve du 2026-09-16) : 21 000 requetes par FENETRE DE SEPT
# JOURS et par cle, calee sur la creation de l'application, plus une par seconde ; les jetons ne sont
# pas comptes. Le plugin ecoute le flux d'evenements (WebSocket, gratuit) pour le vivant, et ne relit
# l'etat complet qu'a la cadence ci-dessous ; la jauge de la vue Robots montre le compte de la semaine.
# AUTOMOWER_APP_KEY=
# AUTOMOWER_APP_SECRET=
# Relecture complete (rattrape ce que le flux aurait manque). 10 min = 1 008 requetes par semaine.
AUTOMOWER_POLL_MS=600000
# Le robot ecrit ses horodatages (prochain depart, erreur) en heure LOCALE : le fuseau de la maison
# les ramene a l'heure vraie. Defaut : celui du serveur.
# AUTOMOWER_TIMEZONE=Europe/Paris
# Ou garder le compte de requetes de la fenetre (sans lui, la jauge repart de zero a chaque redemarrage).
# AUTOMOWER_USAGE_FILE=apps/server/.state/automower-usage.json
# L'instant de remise a zero affiche par le portail developpeur (« Resets at ... »), en ISO 8601, pour
# caler la fenetre exactement. Sans lui, la premiere requete fait foi — a quelques minutes pres.
# Autre voie, sans redemarrer : recaler compte ET instant sur le portail, gardes dans le fichier d'usage :
#   curl -X POST -H 'content-type: application/json' #        -d '{"requests":33,"resetAt":"2026-09-23T17:00:00+02:00"}' http://localhost:8787/api/plugins/automower/usage
# AUTOMOWER_QUOTA_RESET_AT=2026-09-23T17:00:00+02:00

# ---- Plugin COMAP Proteo (station de filtration d'eau) --------------------------------------
# LOCAL, en clair : JSON texte sur TCP/23, aucune decouverte (adresse fixe). Lecture seule pour
# l'instant. Deux surprises par rapport aux autres plugins :
#   - AUCUNE authentification : contrairement a tous les fabricants ci-dessus, rien a appairer ni a
#     coller ici, la station repond a qui la sonde.
#   - Elle N'ACCEPTE QU'UNE CONNEXION A LA FOIS. L'appli mobile du fabricant s'en sert aussi ; une
#     lecture pendant qu'elle tient la connexion est acceptee puis reste MUETTE (aucune reponse, pas
#     d'erreur). D'ou une cadence de sondage prudente et une connexion COURTE (ouvre, lit, ferme) a
#     chaque fois plutot qu'une connexion permanente. Un silence isole est donc normal, pas une
#     panne : le plugin ne declare la station indisponible qu'apres plusieurs echecs de suite.
# Adresse IP de la station (bail DHCP reserve conseille) : TOUJOURS a renseigner.
COMAP_HOST=192.168.1.50
COMAP_PORT=23
# Cadence de sondage. LAN pur, aucun quota, mais chaque lecture est une occasion de tomber en
# collision avec l'appli du fabricant : 30 s suit l'usure et le debit d'assez pres pour l'affichage
# sans les serrer inutilement (ces valeurs ne bougent de toute facon qu'a l'echelle de l'heure).
COMAP_POLL_MS=30000
# Delai avant d'abandonner une lecture restee muette (voir plus haut : normal si isole).
COMAP_TIMEOUT_MS=5000
# Ou garder l'historique de consommation deja calcule (sans lui, il repart de zero a chaque
# redemarrage). Chaine vide = ne rien garder.
# COMAP_HISTORY_FILE=apps/server/.state/comap-consumption.json

# ---- Plugin Mitsubishi MELCloud (pompes a chaleur Ecodan) ------------------------------------
# API CLOUD du fabricant : le module Wi-Fi d'une Ecodan ne parle qu'a MELCloud, il n'existe rien en
# local et aucune voie officielle pour un particulier. Comme Renault, c'est un MOT DE PASSE et pas
# un OAuth : rien a mettre ici.
#
# Mise en route : la carte « Mitsubishi MELCloud » des Reglages (identifiant et mot de passe du
# compte MELCloud). LE MOT DE PASSE N'EST NI GARDE NI ECRIT : il est echange une fois contre une
# cle de session (ContextKey), seule cette cle va dans MELCLOUD_SESSION_FILE.
#
# CE QUI EST PUBLIE : un appareil `climate` par ZONE de chauffage, en LECTURE SEULE (les consignes
# s'affichent, elles ne se reglent pas encore depuis Kasbah). Pas un appareil par machine :
# plusieurs Ecodan en cascade derriere un meme regulateur FTC n'apparaissent que comme UNE machine
# a deux zones. L'etat de la machine (degivrage, appoints, circulateurs, depart/retour, demande)
# n'est pas publie comme appareil : il est servi a la vue Chauffage par
#   GET http://localhost:8787/api/plugins/melcloud/system
# Le releve brut du fabricant reste disponible pour toute nouvelle capture, fenetre d'energie
# reglable (une semaine de septembre rend des zeros sur une machine qui ne chauffe pas) :
#   GET http://localhost:8787/api/plugins/melcloud/raw?from=2026-01-15&to=2026-02-15
# Point d'entree de l'API, au cas ou le fabricant le deplace.
# MELCLOUD_BASE_URL=https://app.melcloud.com/Mitsubishi.Wifi.Client
# Version d'application annoncee a la connexion (MELCloud l'exige).
# MELCLOUD_APP_VERSION=1.34.12.0
# Ou garder la cle de session. Le mot de passe du compte n'y figure jamais.
# MELCLOUD_SESSION_FILE=apps/server/.state/melcloud-session.json
# Cadence de lecture. UN seul appel par tour quel que soit le nombre de machines : ListDevices rend
# tout le compte d'un coup, et il est PLUS RICHE que la lecture detaillee Device/Get (210 champs
# contre 42). La machine remonte au cloud chaque minute ; deux minutes la suivent d'assez pres sans
# la marteler, et le chauffage est de toute facon une grandeur lente.
# MELCLOUD_POLL_MS=120000
# Ou garder l'historique de FONCTIONNEMENT (une semaine d'heures : quand la machine a chauffe,
# combien de temps, a quelle temperature de depart, face a quel dehors). Il est construit par le
# serveur au fil des sondages, et non lu chez le fabricant : cette installation n'a AUCUN compteur
# d'energie, et MELCloud rend des releves vides meme sur un hiver entier. Sans ce fichier,
# l'historique repart de zero a chaque redemarrage. Chaine vide = ne rien garder.
# MELCLOUD_HISTORY_FILE=apps/server/.state/melcloud-history.json

# --- iRobot (Roomba) ----------------------------------------------------------------------------
# Le robot se pilote EN LOCAL : il heberge son propre courtier MQTT (TLS, port 8883) et y pousse son
# etat en continu. Ni sondage, ni quota, rien qui sorte du reseau une fois le compte relie.
#
# Ce qui oblige quand meme a passer par le cloud, UNE fois : le mot de passe de ce courtier. Les
# Roomba le rendaient jadis a qui le demandait sur le reseau (appui long sur HOME puis datagramme
# magique) ; le firmware stingray du parc ne le fait PLUS — 115 tentatives, toujours un refus, et le
# robot l'annonce lui-meme dans sa decouverte avec cap.pw = 0. Il s'obtient donc par le compte.
#
# Mise en route : rien a mettre ici. Le compte se relie depuis les Reglages (identifiant et mot de
# passe iRobot). LE MOT DE PASSE DU COMPTE N'EST NI GARDE NI ECRIT : il est echange une fois contre
# le mot de passe LOCAL de chaque robot, et seul celui-la va dans IROBOT_SESSION_FILE.
#
# Le robot est trouve sur le reseau par diffusion UDP/5678 : aucune adresse IP a configurer, et une
# adresse changee par le DHCP se rattrape au balayage suivant.
#
# Releve brut (les 80 cles que le robot publie, dont la phase 1 n'en garde que quatre) :
#   GET http://localhost:8787/api/plugins/irobot/raw
#
# Mots de passe LOCAUX des robots. Celui du compte n'y figure jamais.
# IROBOT_SESSION_FILE=apps/server/.state/irobot-session.json
# Pays du compte : il choisit le centre Gigya rendu par la decouverte d'endpoints.
IROBOT_COUNTRY=FR
# Points d'entree du fabricant. Defauts dans le code, a renseigner UNIQUEMENT si iRobot les change
# (precedent Renault : une rotation de cles a mis en panne toutes les integrations tierces le meme jour).
# IROBOT_DISCOVERY_URL=https://disc-prod.iot.irobotapi.com/v1/discover/endpoints
# IROBOT_APP_ID=ANDROID-C7FB240E-DF34-42D7-AE4E-A8C17079A294
# IROBOT_USER_AGENT=aspen%20production/2618 CFNetwork/1209 Darwin/20.2.0
# Cadence du balayage reseau. Il ne sert qu'a retrouver un robot qui rentre, s'allume ou change
# d'adresse : l'etat, lui, arrive tout seul par MQTT. Deux minutes suffisent donc largement.
# IROBOT_SCAN_MS=120000
# Duree d'ecoute d'un balayage. Un robot repond en quelques dizaines de millisecondes.
# IROBOT_SCAN_TIMEOUT_MS=4000

# ---- Plugin PetKit (mangeoires et fontaines pour animaux, NON OFFICIEL) -----------------------------
# API PRIVEE de l'appli mobile : rien en local, les mangeoires ne parlent qu'au cloud du fabricant et
# les fontaines passent par la mangeoire voisine (relais Bluetooth). Connexion par CODE recu par
# courriel, depuis la carte « PetKit » des Reglages : aucun mot de passe ne traverse le serveur.
# Utiliser un compte DEDIE, a qui le compte principal partage ses appareils depuis l'appli : une nouvelle connexion
# coupe la precedente, serveur et telephone se deconnecteraient l'un l'autre.
# Ou demander la liste des passerelles regionales (le fabricant la deplace).
# PETKIT_PASSPORT_URL=https://passport.petkt.com/
# Passerelle forcee ; vide = deduite de la region.
# PETKIT_GATEWAY=
# Region du compte (code ISO) : elle choisit la passerelle, et elle seule accepte la session.
# PETKIT_REGION=FR
# PETKIT_TIMEZONE=Europe/Paris
# Version d'application annoncee (PetKit l'exige).
# PETKIT_APP_VERSION=13.2.1
# Jeton de session. Aucun mot de passe, aucun code n'y est jamais ecrit.
# PETKIT_SESSION_FILE=apps/server/.state/petkit-session.json
# Cadence de lecture des mangeoires (grandeurs lentes).
# PETKIT_POLL_MS=300000

# ---- Plugin YouTube Music (NON OFFICIEL) ------------------------------------
# Source musique pour Cast / Sonos via play_url. Pas d'OAuth : coller le cookie du compte
# depuis Reglages (doit contenir __Secure-3PAPISID). Jamais dans .env.
# Necessite : yt-dlp, Node sur le PATH (yt-dlp --js-runtimes node), ffmpeg (FFMPEG_PATH),
# generateur PO Token (port 4416). Voir doc/3_plugins/3_16_ytmusic.md.
# L'adresse publiee aux enceintes est celle du lecteur commun : MUSIC_PUBLISH_BASE, plus bas.
# YTM_COOKIE_FILE=apps/server/.state/ytmusic-cookie.txt
# YTM_PO_TOKEN_URL=http://127.0.0.1:4416
# YTM_YTDLP_PATH=yt-dlp

# ---- Plugin Tuya (ventilateur-lumiere CREATE, protocole local 3.5) ------------
# Pas de cloud apres la cle. Decouverte par broadcast INUTILISABLE (filtre AP Synology) :
# id + cle locale + IP en configuration, bail DHCP statique recommande.
# Tableau JSON : un objet par appareil physique (deux appareils Kasbah : light + fan).
# La cle (16 car., caracteres speciaux) ne doit JAMAIS passer en ligne de commande ni etre loguee.
# Champ facultatif "version" : version du protocole Tuya de l'appareil (defaut 3.5).
# TUYA_DEVICES=[{"id":"<deviceId>","key":"<localKey>","ip":"192.168.1.60","name":"Ventilateur chambre"}]
# Attente de l'effet apres ecriture (ms) ; plafonnee aussi par KASBAH_COMMAND_TIMEOUT_MS.
# TUYA_COMMAND_TIMEOUT_MS=8000
# Intervalle de reconnexion (ms) — la socket tombe sans prevenir.
# TUYA_RECONNECT_MS=700

# ---- Plugin Radios (webradios, annuaire libre radio-browser.info) ---------------------------------
# Aucune cle. Le flux va de la radio a l'enceinte, sans passer par le serveur.
# RADIO_BROWSER_URL=https://de1.api.radio-browser.info
# Favorites de la maison (station complete, jouable meme annuaire tombe).
# RADIO_FAVORITES_FILE=.state/radio-favorites.json
# Pays des « plus ecoutees » (code ISO a deux lettres).
# RADIO_COUNTRY=FR

# ---- Lecteur musique commun (YouTube Music, Mixcloud : file, relais LAN, transfert) --------------
# Adresse publiee aux enceintes Cast/Sonos (elles refusent 127.0.0.1). Vide = deduite de la requete
# du navigateur ; obligatoire si l'interface est ouverte en localhost. YTM_PUBLISH_BASE (ancien nom)
# est encore lu. Le lecteur relaie aussi le son par ffmpeg : FFMPEG_PATH (bloc Nest) vaut pour lui.
# MUSIC_PUBLISH_BASE=http://192.168.1.10:8787
# Derniere ecoute de chaque enceinte (file + position), reprise apres un redemarrage du serveur.
# MUSIC_STATE_FILE=.state/music.json

# ---- Plugin Mixcloud (mix et emissions, API publique + yt-dlp) -------------------------------------
# Aucune cle ni mot de passe : le compte est un NOM d'utilisateur, saisi dans Reglages -> Plugins ou
# sur la page Musique. Il est garde, avec les positions de reprise, dans ce fichier d'etat.
# MIXCLOUD_STATE_FILE=.state/mixcloud.json
# yt-dlp : celui de YouTube Music (YTM_YTDLP_PATH) si rien n'est donne ici.
# MIXCLOUD_YTDLP_PATH=../../_external/yt-dlp.exe
# MIXCLOUD_API_URL=https://api.mixcloud.com

# ---- Plugin Agenda (agendas Google partages, lecture seule) --------------------------------------
# Aucune cle ici : chaque agenda s'ajoute dans Reglages -> agenda en collant son « adresse secrete au
# format iCal » (Google Agenda -> parametres de l'agenda -> Integrer l'agenda). Cette adresse vaut
# mot de passe : elle est gardee dans ce fichier d'etat et ne ressort jamais par l'API.
# AGENDA_FILE=.state/agenda-calendars.json
# Relecture des flux (ms, 1 min au moins).
# AGENDA_REFRESH_MS=600000

# ---- Plugin TouteMonAnnee (cahier de texte, cahier de liaison, publications de la classe) ----------
# API PRIVEE de l'appli web du site. Le compte se relie dans Reglages -> toutemonannee (identifiant +
# mot de passe, utilises UNE fois puis oublies) ; les cookies obtenus sont gardes dans ce fichier d'etat.
# TMA_FILE=.state/toutemonannee.json
# Relecture (ms, 5 min au moins).
# TMA_REFRESH_MS=1800000
# Jours passes relus pour les devoirs.
# TMA_PAST_DAYS=7

# ---- Adresse publique et serveur MCP (/mcp) : comptes, sessions, OAuth -----------------------------
# Comptes (utilisateur + mot de passe hache), a cote de ce .env, hors depot. Les memes ouvrent
# l'application par l'adresse publique et connectent un assistant au MCP. Les gerer dans Reglages ->
# Comptes (reseau local seulement), ou avec
#   npm run mcp-user -w @kasbah/server -- add <nom>      (remove <nom>, list)
# MCP_USERS_FILE=mcp-users.json
# Clients enregistres et jetons (haches). Le supprimer deconnecte tous les clients.
# MCP_AUTH_FILE=.state/mcp-auth.json
# Adresse publique (proxy inverse HTTPS du NAS, ou tunnel). Sous ce nom, le MCP repond avec ses jetons
# (/mcp, /oauth/*, /.well-known/oauth-*) et TOUT le reste (interface, API, cameras, WebSocket) exige
# une session ouverte par /login. Le reseau local reste sans compte. Proxy : transmettre les en-tetes
# WebSocket (DSM : en-tetes personnalises -> Creer -> WebSocket). Lecture sur les enceintes depuis
# l'exterieur : MUSIC_PUBLISH_BASE obligatoire (une enceinte ne lit pas l'adresse publique).
# MCP_PUBLIC_URL=https://kasbah.example.org
# Sessions de l'application (hachees), 90 jours glissants. Le supprimer deconnecte tout le monde.
# KASBAH_SESSIONS_FILE=.state/sessions.json
# Echecs de connexion d'affilee qui bloquent un compte (application et MCP ; 0 = jamais), et duree du
# blocage en minutes. Les sessions deja ouvertes ne sont pas touchees ; un redemarrage debloque tout.
# KASBAH_LOGIN_MAX_FAILURES=5
# KASBAH_LOGIN_LOCK_MINUTES=15
