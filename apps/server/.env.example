# ---- Serveur -------------------------------------------------------------
KASBAH_PORT=8787
KASBAH_HOST=0.0.0.0
# Plugins actifs (ids séparés par des virgules). Implémentés : mock, hue, tahoma, nest. Squelettes :
# google_home, sonos, irobot, automower, melcloud, comap, enphase, tesla, renault.
KASBAH_PLUGINS=mock,hue
# Fichier de description de la maison (défaut : house/demo-house.json à la racine du dépôt).
# KASBAH_HOUSE_FILE=../../house/ma-maison.json
# Dossier du build web servi en production (défaut : apps/web/dist).
# KASBAH_STATIC_DIR=../web/dist
KASBAH_LOG_LEVEL=info
KASBAH_LOG_PRETTY=true
# true → une config de plugin invalide empêche le démarrage (au lieu de désactiver le plugin).
KASBAH_STRICT_PLUGINS=false
KASBAH_COMMAND_TIMEOUT_MS=10000

# ---- Plugin mock (simulation) --------------------------------------------
# Kinds que la simulation ne doit PAS fournir (liste separee par des virgules). Sert a la faire
# COMPLETER un parc reel au lieu de le doubler : des qu'un vrai plugin couvre un kind, ses
# equivalents simules n'ont plus a encombrer les listes en « hors plan ». Un kind inconnu
# desactive le plugin au demarrage plutot que de passer inapercu.
# MOCK_EXCLUDE_KINDS=light,cover
# default | empty | chaos | winter
MOCK_SCENARIO=default
MOCK_SEED=42
# Accélération du temps simulé (60 → une journée en 24 minutes).
MOCK_TIME_SCALE=1
# Date de départ simulée (ISO 8601). Défaut : maintenant.
# MOCK_START_TIME=2026-06-21T06:00:00+02:00

# ---- Plugin Philips Hue ---------------------------------------------------
# IP du bridge (recommandé : fixer un bail DHCP). Absent → découverte via discovery.meethue.com.
HUE_BRIDGE_HOST=192.168.1.20
# Clé d'application obtenue par appairage : lancez le serveur sans clé, appuyez sur le bouton du
# bridge puis POST http://localhost:8787/api/plugins/hue/pair (ou bouton « Appairer » dans Réglages).
# HUE_APP_KEY=
# Exposer aussi les pièces Hue (grouped_light) comme appareils.
HUE_EXPOSE_ROOMS=false
# Le bridge présente un certificat signé par l'autorité Signify (pas par une AC publique).
HUE_TLS_INSECURE=true

# ---- Plugin Somfy TaHoma (volets, stores, portails) -----------------------
# API LOCALE du mode developpeur : aucun appel cloud, ni a la mise en route ni au fonctionnement.
# Tout se fait dans l'appli mobile « TaHoma by Somfy », il n'y a pas de parcours web equivalent :
#   1. « Configurer l'installation » > « Acceder aux parametres » de la box, puis activer le mode
#      developpeur en tapant SEPT FOIS sur le code PIN de la passerelle (format 2001-0001-1891).
#   2. Resynchroniser la box (l'API locale n'est vraiment servie qu'apres).
#   3. Menu « Mode developpeur » > generer un jeton, et le copier TOUT DE SUITE : il n'est
#      affichable qu'a la creation.
#   4. Coller ce jeton dans TAHOMA_TOKEN ci-dessous.
# Adresse de la box : son certificat est emis pour gateway-<PIN>.local, ce nom marche si le mDNS
# passe. Sinon mettre l'IP (bail DHCP fixe recommande) et garder TAHOMA_TLS_INSECURE=true.
TAHOMA_HOST=gateway-2001-0001-1891.local
TAHOMA_PORT=8443
# TAHOMA_TOKEN=
# Le certificat de la box est signe par l'AC Overkiz (pas par une AC publique).
TAHOMA_TLS_INSECURE=true
# L'API locale ne pousse rien : on sonde un ecouteur d'evenements a cette cadence.
TAHOMA_POLL_MS=2000

# ---- Plugin Google Nest (cameras, sonnettes, ecrans a camera) ----------------
# API CLOUD « Smart Device Management » : les appareils Nest n'ont pas d'API locale, rien n'est
# decouvert sur le LAN. Mise en route cote Google, une seule fois (environ 15 minutes, 5 USD) :
#   1. https://console.cloud.google.com : creer un projet, activer l'API « Smart Device Management »,
#      puis « Identifiants » > creer un « ID client OAuth » de type APPLICATION WEB, avec pour URI
#      de redirection autorise EXACTEMENT la valeur de NEST_REDIRECT_URI ci-dessous. Sur l'ecran de
#      consentement, se declarer soi-meme comme utilisateur test (l'appli reste en mode « test »).
#   2. https://console.nest.google.com/device-access : accepter les conditions (5 USD une fois),
#      creer un projet en y collant l'ID client OAuth de l'etape 1. L'id du projet (UUID) est
#      NEST_PROJECT_ID. Ne PAS activer les evenements Pub/Sub pour l'instant (phase suivante).
#   3. Lancer le serveur : le plugin est en « needs_pairing » ; le bouton « Lier le compte Google »
#      des Reglages (ou GET http://localhost:8787/api/plugins/nest/auth/url) ouvre le consentement
#      Google, ou l'on choisit les cameras a partager. Au retour, la page affiche le jeton a coller
#      dans NEST_REFRESH_TOKEN. Le serveur n'ecrit jamais ce fichier.
# Les cameras Nest ne se lient qu'a un compte GOOGLE : un ancien compte Nest doit d'abord etre migre.
# NEST_PROJECT_ID=
# NEST_CLIENT_ID=
# NEST_CLIENT_SECRET=
# NEST_REFRESH_TOKEN=
# Doit correspondre a l'URI declaree dans le client OAuth (le port est celui de KASBAH_PORT).
NEST_REDIRECT_URI=http://localhost:8787/api/plugins/nest/auth/callback
# L'API ne pousse rien (tant que Pub/Sub n'est pas branche) : la liste des appareils est relue a cette
# cadence pour l'etat du thermostat et les ajouts / retraits. Google borne les appels a quelques-uns
# par minute : ne pas descendre trop bas.
NEST_POLL_MS=60000
# Vidéo des caméras RTSP (tout le parc Nest de 1re génération) : un processus ffmpeg par caméra
# regardée recopie le flux (sans ré-encodage) vers le navigateur. Binaire à trouver dans le PATH,
# ou chemin complet ici.
FFMPEG_PATH=ffmpeg
# Vue Cameras : sessions RTSP ouvertes en meme temps, au plus (directs regardes + vignettes). C'est ce
# qui coute (une session Google, un ffmpeg et 1 a 2 Mbit/s par camera), pas la cadence des images.
# En dessous du nombre de cameras, les vignettes tournent en rotation (~20 s de presence chacune).
NEST_LIVE_BUDGET=10
# Cadence des vignettes JPEG (une par camera dont la session est ouverte).
NEST_SNAPSHOT_MS=10000
