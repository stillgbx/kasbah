# ---- Serveur -------------------------------------------------------------
KASBAH_PORT=8787
KASBAH_HOST=0.0.0.0
# Quels plugins sont ACTIFS ne se décide plus ici : c'est un choix de la maison, coché dans
# Réglages → Plugins et écrit dans house.json (`plugins`). Ce fichier ne porte que les clés et les
# secrets. Une maison sans section `plugins` démarre avec la simulation seule.
# Fichier de description de la maison (défaut : house/demo-house.json à la racine du dépôt).
# KASBAH_HOUSE_FILE=../../house/ma-maison.json
# Dossier du build web servi en production (défaut : apps/web/dist).
# KASBAH_STATIC_DIR=../web/dist
KASBAH_LOG_LEVEL=info
KASBAH_LOG_PRETTY=true
# true → une config de plugin invalide empêche le démarrage (au lieu de désactiver le plugin).
KASBAH_STRICT_PLUGINS=false
KASBAH_COMMAND_TIMEOUT_MS=10000

# ---- Plugin mock (simulation) --------------------------------------------
# Ce que la simulation fournit se decoche dans Reglages -> Plugins (un sous-item par type
# d'appareil), pas ici. Sert a la faire COMPLETER un parc reel au lieu de le doubler : des qu'un
# vrai plugin couvre un kind, ses equivalents simules n'ont plus a encombrer les listes en « hors
# plan ». Decocher emporte ce qui appartient a l'INSTALLATION du kind : sortir `energy` retire le
# site solaire simule ET ses vingt panneaux, qui sont des capteurs de puissance mais font partie de
# la meme installation. Les autres capteurs simules (piscine, filtration) restent en place.
# default | empty | chaos | winter
MOCK_SCENARIO=default
MOCK_SEED=42
# Accélération du temps simulé (60 → une journée en 24 minutes).
MOCK_TIME_SCALE=1
# Date de départ simulée (ISO 8601). Défaut : maintenant.
# MOCK_START_TIME=2026-06-21T06:00:00+02:00

# ---- Plugin Philips Hue ---------------------------------------------------
# IP du bridge (recommandé : fixer un bail DHCP). Absent → découverte via discovery.meethue.com.
HUE_BRIDGE_HOST=192.168.1.20
# Clé d'application obtenue par appairage : lancez le serveur sans clé, appuyez sur le bouton du
# bridge puis POST http://localhost:8787/api/plugins/hue/pair (ou bouton « Appairer » dans Réglages).
# HUE_APP_KEY=
# Exposer aussi les pièces Hue (grouped_light) comme appareils.
HUE_EXPOSE_ROOMS=false
# Le bridge présente un certificat signé par l'autorité Signify (pas par une AC publique).
HUE_TLS_INSECURE=true

# ---- Plugin Somfy TaHoma (volets, stores, portails) -----------------------
# API LOCALE du mode developpeur : aucun appel cloud, ni a la mise en route ni au fonctionnement.
# Tout se fait dans l'appli mobile « TaHoma by Somfy », il n'y a pas de parcours web equivalent :
#   1. « Configurer l'installation » > « Acceder aux parametres » de la box, puis activer le mode
#      developpeur en tapant SEPT FOIS sur le code PIN de la passerelle (format 2001-0001-1891).
#   2. Resynchroniser la box (l'API locale n'est vraiment servie qu'apres).
#   3. Menu « Mode developpeur » > generer un jeton, et le copier TOUT DE SUITE : il n'est
#      affichable qu'a la creation.
#   4. Coller ce jeton dans TAHOMA_TOKEN ci-dessous.
# Adresse de la box : son certificat est emis pour gateway-<PIN>.local, ce nom marche si le mDNS
# passe. Sinon mettre l'IP (bail DHCP fixe recommande) et garder TAHOMA_TLS_INSECURE=true.
TAHOMA_HOST=gateway-2001-0001-1891.local
TAHOMA_PORT=8443
# TAHOMA_TOKEN=
# Le certificat de la box est signe par l'AC Overkiz (pas par une AC publique).
TAHOMA_TLS_INSECURE=true
# L'API locale ne pousse rien : on sonde un ecouteur d'evenements a cette cadence.
TAHOMA_POLL_MS=2000

# ---- Plugin Google Nest (cameras, sonnettes, ecrans a camera) ----------------
# API CLOUD « Smart Device Management » : les appareils Nest n'ont pas d'API locale, rien n'est
# decouvert sur le LAN. Mise en route cote Google, une seule fois (environ 15 minutes, 5 USD) :
#   1. https://console.cloud.google.com : creer un projet, activer l'API « Smart Device Management »,
#      puis « Identifiants » > creer un « ID client OAuth » de type APPLICATION WEB, avec pour URI
#      de redirection autorise EXACTEMENT la valeur de NEST_REDIRECT_URI ci-dessous. Sur l'ecran de
#      consentement, se declarer soi-meme comme utilisateur test (l'appli reste en mode « test »).
#   2. https://console.nest.google.com/device-access : accepter les conditions (5 USD une fois),
#      creer un projet en y collant l'ID client OAuth de l'etape 1. L'id du projet (UUID) est
#      NEST_PROJECT_ID. Les evenements Pub/Sub (sonnette) sont pris en charge : voir NEST_PUBSUB_* plus bas.
#   3. Lancer le serveur : le plugin est en « needs_pairing » ; le bouton « Lier le compte Google »
#      des Reglages (ou GET http://localhost:8787/api/plugins/nest/auth/url) ouvre le consentement
#      Google, ou l'on choisit les cameras a partager. Au retour, la page affiche le jeton a coller
#      dans NEST_REFRESH_TOKEN. Le serveur n'ecrit jamais ce fichier.
# Les cameras Nest ne se lient qu'a un compte GOOGLE : un ancien compte Nest doit d'abord etre migre.
# NEST_PROJECT_ID=
# NEST_CLIENT_ID=
# NEST_CLIENT_SECRET=
# NEST_REFRESH_TOKEN=
# Doit correspondre a l'URI declaree dans le client OAuth (le port est celui de KASBAH_PORT).
NEST_REDIRECT_URI=http://localhost:8787/api/plugins/nest/auth/callback
# L'API ne pousse rien (tant que Pub/Sub n'est pas branche) : la liste des appareils est relue a cette
# cadence pour l'etat du thermostat et les ajouts / retraits. Google borne les appels a quelques-uns
# par minute : ne pas descendre trop bas.
NEST_POLL_MS=60000
# Vidéo des caméras RTSP (tout le parc Nest de 1re génération) : un processus ffmpeg par caméra
# regardée recopie le flux (sans ré-encodage) vers le navigateur. Binaire à trouver dans le PATH,
# ou chemin complet ici.
FFMPEG_PATH=ffmpeg
# Vue Cameras : sessions RTSP ouvertes en meme temps, au plus (directs regardes + vignettes). C'est ce
# qui coute (une session Google, un ffmpeg et 1 a 2 Mbit/s par camera), pas la cadence des images.
# En dessous du nombre de cameras, les vignettes tournent en rotation (~20 s de presence chacune).
NEST_LIVE_BUDGET=10
# Cadence des vignettes JPEG (une par camera dont la session est ouverte).
NEST_SNAPSHOT_MS=10000
# Evenements Pub/Sub (sonnette, mouvement). Optionnel : sans abonnement, aucun evenement, le reste
# marche. Cote Google : projet Cloud avec facturation active (Pub/Sub l'exige, mais le volume d'un
# foyer reste dans le quota gratuit ~ 0 EUR), API Pub/Sub activee, un sujet, un abonnement de type
# PULL, droit de publication donne au compte Device Access, sujet valide dans la console Device
# Access, et la liaison OAuth refaite (portee pubsub). Voir doc/3_plugins/3_5_google-nest.md.
# Nom COMPLET de l'abonnement (projet Cloud, pas l'UUID Device Access) :
# NEST_PUBSUB_SUBSCRIPTION=projects/<projet-cloud>/subscriptions/nest-events-sub
# Cadence de tirage de l'abonnement (une sonnerie arrive au plus tard au prochain tirage).
NEST_PUBSUB_POLL_MS=5000

# ---- Plugin Google Cast (enceintes et reveils Google / Nest, Chromecast, TV Android) ---------
# Tout est LOCAL : decouverte mDNS (_googlecast._tcp), une connexion TLS par appareil, aucun compte.
# Le nom, le modele et l'identifiant stable viennent de l'annonce mDNS ; volume, appli en cours et
# lecture sont pousses par l'appareil. Penser a decocher « Lecteur » dans les sous-items du mock.
# Machine a plusieurs cartes reseau (VPN, machines virtuelles) : la question mDNS peut partir sur la
# mauvaise. Donner ici l'IPv4 de la carte qui est sur le LAN des appareils.
# CAST_MDNS_INTERFACE=192.168.1.10
# Temps laisse aux appareils pour repondre a la premiere question avant de rendre la liste.
CAST_DISCOVERY_WAIT_MS=3000
# Cadence des questions mDNS suivantes (appareils rallumes, annonces perdues).
CAST_MDNS_REFRESH_MS=60000
# Memoire des appareils deja vus : un Cast ETEINT ne s'annonce plus en mDNS. Sans elle il quitte
# l'inventaire, et une entree de house.json qui le vise perd son nom, son icone et son etat. Retenu ici,
# il reste liste (indisponible) et se rattache des qu'il se reannonce ; le bouton « Oublier l'appareil »
# de l'UI l'en sort. Chaine vide = ne rien retenir.
# CAST_KNOWN_FILE=apps/server/.state/google-cast-devices.json
# Lectures Crunchyroll : l'appli n'envoie que le titre de l'episode ; le serveur complete serie, saison,
# numero et vignette par l'API interne du service, en ANONYME (aucun compte). Non officiel, peut casser
# sans preavis ; en cas d'echec l'affichage reste celui de l'appareil. false pour s'en passer.
CAST_CRUNCHYROLL_ENRICH=true
# Pochette d'un morceau que l'appareil NOMME sans l'illustrer (une appli de TV Android n'envoie aucune
# image, et son identifiant de contenu est vide) : cherchee par titre + artiste dans les catalogues
# publics iTunes puis Deezer, sans cle ni compte. La correspondance est VERIFIEE avant d'accepter une
# image (iTunes repond toujours quelque chose, meme sans rapport) ; sinon il reste le logo de l'appli.
# C'est la pochette de l'ALBUM, pas la vignette de la video. false pour s'en passer.
CAST_COVER_LOOKUP=true
# TV Sony (modele BRAVIA) : lui demander OU PART SON SON par son API REST locale (port 80, sans cle ni
# appairage) toutes les 10 s tant qu'elle est connectee. Une TV en HDMI ARC fait jouer une barre de son
# que le protocole Cast voit au repos ; publie dans l'etat `audioOutput` (haut-parleurs / systeme audio,
# nom CEC de l'appareil branche). L'UI y pose l'onde sonore avec le lien `meta.audioOutput` de house.json
# (sur l'appareil TV : l'id maison de la barre). false pour s'en passer.
CAST_BRAVIA_PROBE=true

# --- Enphase (production solaire, micro-onduleurs, batteries) ------------------------------------
# Passerelle IQ lue en LOCAL : aucun quota cloud, aucune dependance a Internet une fois le jeton pose.
# Nom ou IP de la passerelle. `envoy.local` est le nom qu'elle porte sur le LAN (HTTPS seul : son
# port 80 refuse la connexion, et son certificat est auto-signe, ce que le serveur accepte pour elle).
ENPHASE_HOST=envoy.local
# Le logiciel 7.0 et plus exige un JETON (JWT). RIEN A METTRE ICI dans le cas normal : l'appairage se
# fait depuis la carte « Passerelle Enphase » des Reglages, et le serveur garde le jeton lui-meme
# dans ENPHASE_TOKEN_FILE (voir plus bas). Il n'y a donc rien a recopier, meme en appairant depuis
# une tablette, et le jeton vaut un an. Le serveur previent quand il reste moins de 30 jours
# (pastille orange des Reglages), et a l'heure pres le dernier jour.
# La carte propose deux voies. Les identifiants du compte Enphase, qui traversent la requete, servent
# une fois a frapper le jeton et sont OUBLIES : ni journalises, ni ecrits, ni des cles de ce fichier.
# Ou un jeton deja cree sur https://entrez.enphaseenergy.com, a coller dans la carte.
# ATTENTION au formulaire web du fabricant : pour un compte a la fois installateur et proprietaire
# (un auto-installateur), il ne delivre qu'un jeton de 12 H. Seule la voie par identifiants rend
# celui d'un an. Le role est lisible dans le jeton, et les Reglages l'affichent.
# Le numero de serie n'est jamais a saisir : /info le donne sans authentification.
# La cle ci-dessous reste lue, comme jeton d'AMORCAGE : utile pour un premier demarrage sans
# interface, ou pour forcer un jeton precis. Entre ce jeton et celui du cache, le serveur garde
# celui qui expire LE PLUS TARD, donc un vieux jeton oublie ici n'eclipse pas un jeton frais.
# ENPHASE_TOKEN=
# Ou garder le jeton entre deux demarrages (il vaut un an) : c'est ce qui evite de retaper quoi que
# ce soit. Chaine vide = ne rien garder, et donc reappairer a chaque demarrage.
# ENPHASE_TOKEN_FILE=apps/server/.state/enphase-token.json
