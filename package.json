{
  "name": "kasbah",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @kasbah/server\" \"npm run dev -w @kasbah/web\"",
    "house": "concurrently -n house,web -c blue,green \"npm run house -w @kasbah/server\" \"npm run dev -w @kasbah/web\"",
    "dev:pot": "node scripts/dev-pot.mjs",
    "build": "npm run build -w @kasbah/web -w @kasbah/server",
    "start": "npm run start -w @kasbah/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check:private": "node scripts/check-private.mjs --all",
    "hooks": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
